<%- include('partials/header') %>

  <main>
    <section class="page-header">
      <div class="container">
        <h1>About Us</h1>
        <p>Our story, our mission, and why we do what we do.</p>
      </div>
    </section>

    <!-- Story -->
    <section class="section">
      <div class="container">
        <div class="about-story">
          <div class="about-story-text">
            <h2>Our Story</h2>
            <p>Dally's Hope 4 Paws Rescue started with a simple belief: every dog deserves a safe, loving home. Based in Hagaman, New York, we're a small team of volunteers who rescue dogs from local situations and partner with rural shelters in the South where resources are limited and euthanasia rates are high.</p>
            <p>We work with a network of foster homes across New York, Connecticut, and Vermont. Every dog in our care lives in a foster home — not a kennel — where they get the individual attention and care they need to heal, learn, and prepare for their forever family.</p>
            <p>We're a registered 501(c)(3) nonprofit, and every dollar donated goes directly to the dogs: veterinary care, food, supplies, and transport.</p>
          </div>
          <div class="about-story-image">
            <img src="/images/about-volunteers.jpg" alt="Volunteer with rescue dogs">
          </div>
        </div>
      </div>
    </section>

    <!-- Mission -->
    <section class="section section--tight">
      <div class="container">
        <div class="mission-block">
          <p>"To rescue dogs in need, provide them with compassionate care, and find them loving, permanent homes. We believe every dog — regardless of age, breed, or background — deserves a second chance."</p>
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="section">
      <div class="container">
        <div class="section-header">
          <h2>Our Impact</h2>
        </div>
        <div class="stats-row">
          <div class="stat-item">
            <span class="stat-number">200+</span>
            <span class="stat-label">Dogs Rescued</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">3</span>
            <span class="stat-label">States Served</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">7,800+</span>
            <span class="stat-label">Community Members</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Registration -->
    <section class="section section--tight">
      <div class="container">
        <div class="registration-info">
          <h3>Official Registration</h3>
          <p><strong>Legal Name:</strong> Dally's Hope 4 Paws Rescue Inc.</p>
          <p><strong>EIN:</strong> 82-3825005</p>
          <p><strong>NYS Registration:</strong> #RR277</p>
          <p><strong>Mailing Address:</strong> PO Box 346, Hagaman, NY 12066</p>
        </div>
      </div>
    </section>
  </main>

