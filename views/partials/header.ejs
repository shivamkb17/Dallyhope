<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="Dally's Hope 4 Paws Rescue Inc. — All-breed dog rescue serving New York, Connecticut, and Vermont. Based in Hagaman, NY.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
  <link rel="icon" type="image/jpeg" href="/images/logo.jpg">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="canonical" href="https://dallyshope4pawsrescue.org<%= currentPage === 'home' ? '/' : '/' + currentPage %>">
</head>
<body>
  <header class="site-header">
    <div class="container">
      <a href="/" class="site-logo">
        <img src="/images/logo.jpg" alt="Dally's Hope Logo" class="site-logo-img">
        <span>Dally's Hope</span>
      </a>
      <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
      <nav>
        <ul class="nav-list">
          <li><a href="/" class="<%= currentPage === 'home' ? 'active' : '' %>">Home</a></li>
          <li><a href="/about" class="<%= currentPage === 'about' ? 'active' : '' %>">About</a></li>
          <li><a href="/adopt" class="<%= currentPage === 'adopt' ? 'active' : '' %>">Adopt</a></li>
          <li><a href="/help" class="<%= currentPage === 'help' ? 'active' : '' %>">How to Help</a></li>
          <li><a href="/contact" class="<%= currentPage === 'contact' ? 'active' : '' %>">Contact</a></li>
        </ul>
      </nav>
    </div>
  </header>
