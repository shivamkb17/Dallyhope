<%- include('partials/header') %>

  <main class="dog-detail-page">
    <div class="container py-24">
      <!-- Back button -->
      <a href="/adopt" class="back-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Back to Adoptable Dogs
      </a>

      <div class="dog-detail-layout">
        <!-- Photo - Double-Bezel Nested Architecture -->
        <div class="dog-detail-media-shell">
          <div class="dog-detail-media-core">
            <img src="<%= dog.photo %>" alt="<%= dog.name %> — <%= dog.breed %>" class="dog-detail-img" fetchpriority="high">
            <% if (dog.status === 'pending') { %>
              <span class="dog-badge dog-badge--pending">Adoption Pending</span>
            <% } else { %>
              <span class="dog-badge dog-badge--available">Available</span>
            <% } %>
          </div>
        </div>

        <!-- Info & Description -->
        <div class="dog-detail-info">
          <div class="dog-header-group">
            <span class="eyebrow-tag">Meet your new best friend</span>
            <h1 class="dog-detail-name"><%= dog.name %></h1>
            <p class="dog-detail-breed"><%= dog.breed %></p>
          </div>

          <!-- Quick Stats Grid -->
          <div class="dog-stats-grid">
            <div class="dog-stat-card">
              <span class="stat-label">Age</span>
              <span class="stat-value"><%= dog.age %></span>
            </div>
            <div class="dog-stat-card">
              <span class="stat-label">Sex</span>
              <span class="stat-value"><%= dog.sex %></span>
            </div>
            <div class="dog-stat-card">
              <span class="stat-label">Weight</span>
              <span class="stat-value"><%= dog.weight %></span>
            </div>
          </div>

          <!-- Description -->
          <div class="dog-detail-bio">
            <h2>About <%= dog.name %></h2>
            <p><%= dog.description %></p>
          </div>

          <!-- CTAs -->
          <div class="dog-detail-actions">
            <button class="btn btn--primary btn--lg btn-inquire" id="open-inquiry-btn">
              Inquire About <%= dog.name %>
              <span class="btn-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                </svg>
              </span>
            </button>

            <!-- Minimal external link to Petfinder -->
            <a href="<%= dog.petfinderUrl %>" target="_blank" rel="noopener noreferrer" class="petfinder-secondary-link">
              View original listing on Petfinder
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Modern HTML5 Dialog Inquiry Modal -->
    <dialog id="inquiry-dialog" class="modern-dialog">
      <div class="dialog-wrapper">
        <button class="dialog-close" id="close-inquiry-btn" aria-label="Close dialog">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>

        <div id="dialog-form-container">
          <h2>Inquire About <%= dog.name %></h2>
          <p class="dialog-subtitle">Send us a message and our volunteers will get back to you soon.</p>

          <form id="inquiry-form" method="POST" action="/contact">
            <input type="hidden" name="subject" value="Adoption Inquiry — <%= dog.name %>">
            
            <div class="form-group">
              <label for="inquiry-name">Your Name</label>
              <input type="text" id="inquiry-name" name="name" required placeholder="John Doe">
            </div>

            <div class="form-group">
              <label for="inquiry-email">Your Email</label>
              <input type="email" id="inquiry-email" name="email" required placeholder="john@example.com">
            </div>

            <div class="form-group">
              <label for="inquiry-message">Your Message</label>
              <textarea id="inquiry-message" name="message" required rows="4">Hi! I am interested in adopting <%= dog.name %> and would love to learn more about <%= dog.sex === 'Male' ? 'him' : 'her' %> and the adoption process. Thank you!</textarea>
            </div>

            <button type="submit" class="btn btn--primary btn--lg w-full">
              Send Inquiry
              <span class="btn-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="22" y1="2" x2="11" y2="13"></line>
                  <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
              </span>
            </button>
          </form>
        </div>

        <!-- Success view (hidden initially) -->
        <div id="dialog-success-container" style="display: none;">
          <div class="success-icon-wrapper">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="success-checkmark">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <h2>Inquiry Sent!</h2>
          <p>Thank you for your interest in <%= dog.name %>! A volunteer from Dally's Hope will contact you via email shortly.</p>
          <button class="btn btn--primary btn--lg w-full" id="success-close-btn">Close Window</button>
        </div>
      </div>
    </dialog>
  </main>

<%- include('partials/footer') %>
